# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/focusguard?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=replace_with_your_database_password

# JWT 配置
JWT_SECRET=replace_with_your_base64_jwt_secret
JWT_EXPIRATION_MS=86400000

# 邮箱配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_your_email@qq.com
MAIL_PASSWORD=replace_with_your_smtp_authorization_code

# 云端运行配置
PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
